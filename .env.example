# Copy to .env.local; never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_QA_MODEL=gpt-5-mini
OPENAI_OCR_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ADMIN_USERNAME=admin
# Set a unique 10–128 character password before the first login.
# This bootstraps a new account; changing it later does not reset an existing one.
ADMIN_PASSWORD=
# Optional: only needed to query previously imported text-embedding-v4 indexes.
COPILOT_EMBEDDING_API_KEY=
COPILOT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
