diff --git a/lib/guard.js b/lib/guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..d174cb617e0bc59eed8e6ddf88e601e7db92bd81
--- /dev/null
+++ b/lib/guard.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Check without recursion before
+// entering any recursive AST walker, including callers supplying an AST.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') throw new TypeError('Invalid brace AST');
+    if (depth >= 64 || seen.has(node) || ++count > 100000) {
+      throw new SyntaxError('Brace AST exceeds safe depth or size');
+    }
+    seen.add(node);
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes) || node.nodes.length > 100000) throw new SyntaxError('Invalid brace AST nodes');
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
